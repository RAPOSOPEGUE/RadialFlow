{
  "name": "radialflow",
  "version": "0.1.0",
  "description": "Menu radial de atalhos contextuais acionado por arrasto com o botão direito (Windows)",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "inc.jager.radialflow",
    "productName": "RadialFlow",
    "win": { "target": "nsis" },
    "extraResources": [{ "from": "scripts", "to": "scripts" }]
  }
}
